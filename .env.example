# ============================================================
# bugbounty 环境变量模板
# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，切勿提交
# ============================================================

# ---- 授权与范围（留空 = 全域 / 无排除）----
BB_SCOPE=
BB_EXCLUDE=

# ---- 身份（注册 / 登录用；越权测试需 >= 2 个）----
BB_PHONE_A=
BB_EMAIL_A=
BB_PHONE_B=
BB_EMAIL_B=

# ---- 网络出口 ----
# 国内出口 = 直连，无需配置
# 国外出口 = 任意 HTTP 代理均可（Clash / v2ray / mihomo / mitmproxy / 公司代理）
#   BB_PROXY_OS_LOCAL : 本机脚本视角，通常是 http://127.0.0.1:<端口>
#   BB_PROXY_OS_KALI  : Kali 视角，是 Windows 主机在 VM 网段上的地址
#                       （VMware NAT 下通常是 http://192.168.x.1:<端口>）
#   两者留空 = 不做国外出口，只测国内目标
BB_PROXY_OS_LOCAL=
BB_PROXY_OS_KALI=
BB_USER_AGENT=

# ---- Kali（经 kali MCP 连接；此处仅供需要直连 ssh 的脚本使用）----
KALI_HOST=
KALI_PORT=22
KALI_USER=
KALI_KEY_PATH=

# ---- 浏览器 ----
CDP_PORT=9222

# ---- Clash 节点切换（可选）----
# 仅在"使用 Clash 且需要自动切换节点"时填写；留空则自动探测常见配置路径。
# 探测顺序见 scripts/clash.py；探测不到时该功能静默跳过，不影响主流程。
CLASH_CONTROLLER=
CLASH_SECRET=

# ---- mitmproxy（可选）----
# 留空则从 PATH 与常见安装位置自动探测
MITMDUMP_PATH=
WECHAT_LISTEN_PORT=8082

# ---- provider API ----
# 国内（直连）
QUAKE_API_KEY_1=
QUAKE_API_KEY_2=
HUNTER_API_KEY=
ZOOMEYE_API_KEY=
# 国外（走 BB_PROXY_OS_LOCAL，实测直连可通则自动降级直连）
SHODAN_API_KEY=
CENSYS_API_KEY=
NETLAS_API_KEY=
ABUSEIPDB_API_KEY=
IPINFO_API_KEY=
URLSCAN_API_KEY=
OTX_API_KEY=
GITHUB_TOKEN=
CERTSPOTTER_API_KEY=
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=
GREYNOISE_API_KEY=
# 无需 key（免费公开接口）
# CRTSH / WAYBACK —— 留空即可，脚本会直接调用

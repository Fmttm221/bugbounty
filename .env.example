# ============================================================
# raven 环境变量模板
# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，切勿提交
# ============================================================

# ---- 授权与范围（留空 = 全域 / 无排除）----
RVN_SCOPE=
RVN_EXCLUDE=

# ---- 身份（注册 / 登录用；越权测试需 >= 2 个）----
RVN_PHONE_A=
RVN_EMAIL_A=
RVN_PHONE_B=
RVN_EMAIL_B=

# ---- 网络出口 ----
# 国内出口 = 直连，无需配置
# 国外出口 = 任意 HTTP 代理均可（Clash / v2ray / mihomo / mitmproxy / 公司代理）
#   RVN_PROXY_OS_LOCAL : 本机脚本视角，通常是 http://127.0.0.1:<端口>
#   RVN_PROXY_OS_KALI  : Kali 视角，是 Windows 主机在 VM 网段上的地址
#                       （VMware NAT 下通常是 http://192.168.x.1:<端口>）
#   两者留空 = 不做国外出口，只测国内目标
RVN_PROXY_OS_LOCAL=
RVN_PROXY_OS_KALI=
RVN_USER_AGENT=

# ---- Kali ----
# 仅供 preflight 核对"我连的是哪台 Kali"。实际连接由 kali MCP 管理，
# MCP 自带主机与密钥配置，不读这里 —— 避免连接参数的第二个真相源。
KALI_HOST=
KALI_USER=

# ---- 浏览器 ----
CDP_PORT=9222

# ---- Clash 节点切换（可选）----
# 仅在"使用 Clash 且需要自动切换节点"时填写；留空则自动探测常见配置路径。
# 探测顺序见 scripts/clash.py；探测不到时该功能静默跳过，不影响主流程。
CLASH_CONTROLLER=
CLASH_SECRET=

# ---- mitmproxy（可选）----
# 留空则从 PATH 与常见安装位置自动探测
MITMDUMP_PATH=
WECHAT_LISTEN_PORT=8082
# 抓包范围：正则白名单 / 逗号分隔黑名单。留空用脚本内置默认值
WECHAT_KEEP_HOSTS=
WECHAT_EXCLUDE_HOSTS=

# ---- provider API ----
# 国内（直连）
QUAKE_API_KEY_1=
QUAKE_API_KEY_2=
HUNTER_API_KEY=
ZOOMEYE_API_KEY=
# 国外（走 RVN_PROXY_OS_LOCAL，实测直连可通则自动降级直连）
SHODAN_API_KEY=
CENSYS_API_KEY=
NETLAS_API_KEY=
ABUSEIPDB_API_KEY=
IPINFO_API_KEY=
URLSCAN_API_KEY=
OTX_API_KEY=
GITHUB_TOKEN=
# 无需 key（脚本直接调用）：CRTSH / WAYBACK / CERTSPOTTER
# OTX 的 indicator 端点也无需 key（passive_dns 才需要）

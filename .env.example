# ============================================================
# bugbounty 环境变量模板 —— 复制为 .env 后填写真实值
# .env 已被 .gitignore 忽略，切勿提交
# ============================================================

# ---- 授权与范围（必填）----
BUG_BOUNTY_SCOPE=
BUG_BOUNTY_EXCLUDE=

# ---- 个人身份信息 ----
BB_PHONE=
BB_EMAIL=

# ---- 代理 / 出口 IP ----
BB_PROXY=
BB_USER_AGENT=

# ---- MCP / 远端 Kali ----
KALI_HOST=
KALI_PORT=
KALI_USER=
KALI_KEY_PATH=

# ---- 第三方 API ----
BB_API_KEY=